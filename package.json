{
  "name": "d3-flame-graph",
  "version": "4.1.3",
  "description": "A d3.js library to produce flame graphs.",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:main:min && npm run build:colorMapper && npm run build:colorMapper:min && npm run build:tooltip && npm run build:tooltip:min && npm run build:template && node scripts/build-template.js",
    "build:main": "vite build --config vite.config.mjs",
    "build:main:min": "vite build --config vite.config.min.mjs",
    "build:colorMapper": "vite build --config vite.config.colorMapper.mjs",
    "build:colorMapper:min": "vite build --config vite.config.colorMapper.min.mjs",
    "build:tooltip": "vite build --config vite.config.tooltip.mjs",
    "build:tooltip:min": "vite build --config vite.config.tooltip.min.mjs",
    "build:template": "vite build --config vite.config.template.mjs",
    "dev": "vite",
    "serve": "vite",
    "lint": "eslint src test",
    "pretest": "npm run build",
    "test": "jest",
    "prepare": "npm run test",
    "postpublish": "zip -j dist/d3-flamegraph.zip -- LICENSE README.md dist/d3-flamegraph.js dist/d3-flamegraph.min.js dist/d3-flamegraph-colorMapper.js dist/d3-flamegraph-colorMapper.min.js dist/d3-flamegraph-tooltip.js dist/d3-flamegraph-tooltip.min.js dist/d3-flamegraph.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spiermar/d3-flame-graph.git"
  },
  "keywords": [
    "d3",
    "flamegraph",
    "performance"
  ],
  "author": "Martin Spier <spiermar@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/spiermar/d3-flame-graph/issues"
  },
  "homepage": "https://github.com/spiermar/d3-flame-graph#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.3",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": "standard"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "d3-array": "^3.1.1",
    "d3-dispatch": "^3.0.1",
    "d3-ease": "^3.0.1",
    "d3-format": "^3.0.1",
    "d3-hierarchy": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1"
  }
}
